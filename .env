# make Node_env as Prodiction
NODE_ENV=

# ---------------------------------------------------------------------------
# Backend API
#
# Inlined into the browser bundle at BUILD time — changing it needs a rebuild,
# not just a restart. It MUST stay same-origin: the page is served over HTTPS, so
# an absolute http:// URL here is blocked by the browser as mixed content and
# never reaches the network. That is what broke every POST/PUT/PATCH/DELETE and
# the current-user lookup. nginx proxies `/backend-api/` to the backend server.
NEXT_PUBLIC_API_URL=/backend-api

# Read at RUNTIME by the node process, which calls the backend server directly
# instead of going back out through nginx. Must stay absolute, and must be named
# API_URL — getServerApiUrl() in src/lib/api-url.ts throws when it is missing,
# which takes down login and every server-rendered page.
# Note this hop crosses the network unencrypted; it is not a local connection.
API_URL=http://fp28-back.inss.local:7000
# ---------------------------------------------------------------------------

# NextAuth secret - replace with a secure random string in production
NEXTAUTH_SECRET=ee42887d1f70cb150fa64afa20dd0a4c870d5942a11489d150aaa87d7a6d2b0c

# Must match the scheme the browser actually uses, otherwise NextAuth issues
# non-Secure cookies and http callback URLs that nginx then 301-redirects.
NEXTAUTH_URL=https://fp28.inss.local
