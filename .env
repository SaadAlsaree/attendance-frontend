# make Node_env as Prodiction
NODE_ENV=

# ---------------------------------------------------------------------------
# Backend API
#
# The browser value MUST stay same-origin. The page is served over HTTPS, so an
# absolute http:// URL here is blocked by the browser as mixed content and never
# reaches the network — that is what broke every POST/PUT/PATCH/DELETE and the
# current-user lookup. `/backend-api` is proxied to the API by nginx.
NEXT_PUBLIC_API_URL=/backend-api

# The node process talks to the API directly, bypassing nginx: no TLS trust
# needed and no extra hop. Must stay absolute.
INTERNAL_API_URL=http://fp28-back.inss.local:7000
# ---------------------------------------------------------------------------

# NextAuth secret - replace with a secure random string in production
NEXTAUTH_SECRET=ee42887d1f70cb150fa64afa20dd0a4c870d5942a11489d150aaa87d7a6d2b0c

# Must match the scheme the browser actually uses, otherwise NextAuth issues
# non-Secure cookies and http callback URLs that nginx then 301-redirects.
NEXTAUTH_URL=https://fp28.inss.local
